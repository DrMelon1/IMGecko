{
    "manifest_version": 3,
    "name": "IMGecko",
    "version": "1.0",
    "description": "Save images as PNG, JPG, WebP, AVIF, GIF, BMP, ICO, TIFF, TGA, QOI, SVG, PCX, Netpbm, and more.",
    "permissions": ["contextMenus", "downloads"],
    "host_permissions": ["<all_urls>"],
    "browser_specific_settings": {
        "gecko": {
            "id": "imgecko@drmelon1.github.io",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["*://*.instagram.com/*"],
            "js": ["src/scripts/instagram_script.js"],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "scripts": [
            "src/shared/format_registry.js",
            "src/vendor/gifenc.min.js",
            "src/shared/image_loader.js",
            "src/shared/encoders/canvas_encoders.js",
            "src/shared/encoders/binary_encoders.js",
            "src/shared/encoders/text_encoders.js",
            "src/shared/encoder_runtime.js",
            "src/scripts/menu_script.js"
        ]
    },
    "icons": {
        "16": "src/icons/IMGeckoIcon16pxLight.png",
        "32": "src/icons/IMGeckoIcon32pxLight.png",
        "48": "src/icons/IMGeckoIcon48pxLight.png",
        "128": "src/icons/IMGeckoIcon128pxLight.png"
    }
}
